#!/bin/sh

# xinitrc runs automatically when you run startx.

# There are some small but important commands that need to be run when we start
# the graphical environment. There is a link to this file in ~/.xprofile
# because that file is run automatically if someone uses a display manager
# (login screen) and so they are needed there. To prevent doubling up commands,
# I source them here with the line below.

# Fedora: xinit runs the system /etc/X11/xinit/xinitrc only when the user has
# no xinitrc of their own, so these snippets would otherwise never run. The one
# that matters is 50-systemd-user.sh, which imports DISPLAY and XAUTHORITY into
# the systemd user manager -- without it anything D-Bus-activated (dunst,
# gnome-keyring, the portals) starts with no DISPLAY and misbehaves in ways
# that are very hard to attribute. localuser.sh relaxes xhost for this user.
if [ -d /etc/X11/xinit/xinitrc.d ]; then
	for f in /etc/X11/xinit/xinitrc.d/?*.sh; do
		[ -x "$f" ] && . "$f"
	done
	unset f
fi

if [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/x11/xprofile" ]; then
	. "${XDG_CONFIG_HOME:-$HOME/.config}/x11/xprofile"
else
	. "$HOME/.xprofile"
fi
# Activate dbus variables
dbus-update-activation-environment --all

# Say plainly when the window manager is not actually installed. If fedora.sh
# stopped before it built the suckless programs -- which is what happens when
# the machine has no network, the failure this port was most often hit by --
# then dwm is simply not on $PATH, and `exec ssh-agent dwm` dies with nothing
# more useful than "No such file or directory" as X tears the screen down. The
# result looks like a broken graphical stack rather than an unfinished install.
for prog in dwm ssh-agent; do
	command -v "$prog" >/dev/null 2>&1 || {
		printf '%s is not installed or not on $PATH.\n' "$prog" >&2
		printf 'The install did not finish. Check /var/log/fedora-larbs.log,\n' >&2
		printf 'then re-run fedora.sh once the network is working.\n' >&2
		exit 1
	}
done
unset prog

# Fedora already has a systemd user session bus (dbus-broker at
# $XDG_RUNTIME_DIR/bus, exported by pam_systemd long before this file runs).
# Upstream's `dbus-launch` here is an Artix/runit accommodation: on systemd it
# starts a second, competing bus, after which dunst, gnome-keyring and pinentry
# each talk to whichever one they happened to inherit. The symptom is
# notifications that work intermittently and keyring prompts that never appear.
exec ssh-agent dwm
