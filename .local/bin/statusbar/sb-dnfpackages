#!/bin/sh

# Displays the number of upgradeable packages.
# For this to work, have `cron/checkup` run periodically to refresh dnf's
# metadata; this script only reads the result. Clicking it runs the upgrade.
#
# dnf has no equivalent of pacman's libalpm hooks, so there is no system hook to
# install that would refresh this after a manual upgrade. sb-popupgrade signals
# the bar itself when it finishes, which covers the case that matters.

case $BLOCK_BUTTON in
	1) setsid -f "$TERMINAL" -e sb-popupgrade ;;
	2) notify-send "📦 Upgradable packages" "$(dnf -q list --upgrades 2>/dev/null)" ;;
	3) notify-send "🎁 Upgrade module" "📦: number of upgradable packages
- Left click to upgrade packages
- Middle click to show upgradable packages" ;;
	6) setsid -f "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

# Read the count cron/checkup cached, and nothing else. This script is run on
# every bar refresh, and calling dnf here meant a network round trip each time:
# under dnf5 that stalls the whole bar for seconds and spins the CPU. Until
# checkup has run once the file does not exist, and the block stays empty.
cachefile="${XDG_CACHE_HOME:-$HOME/.cache}/larbs/dnf-updates"

[ -r "$cachefile" ] || exit 0
read -r n <"$cachefile" || exit 0

# Guard the read: an empty or half-written file must not reach printf as a
# "invalid number" error on every refresh.
[ "${n:-0}" -gt 0 ] 2>/dev/null || exit 0

printf "📦%d\n" "$n"
