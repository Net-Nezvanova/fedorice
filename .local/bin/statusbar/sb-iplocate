#!/bin/sh

# Gets your public IP address, checks which country you are in and
# displays that information in the statusbar.
#
# Fedora note: upstream used geoiplookup from the GeoIP package. Fedora does
# still ship GeoIP, but its data package has been frozen at 2018 for years and
# Red Hat's own bug for it says to use mmdblookup instead -- whose Fedora data
# package is equally stale. Both would answer confidently and wrongly. An HTTP
# lookup needs no package at all, is always current, and returns the full
# country name the flag table below is keyed on.

countryfile="$XDG_RUNTIME_DIR/iplocate"

getcountry() {
	{ grep -q -m1 '^up$' /sys/class/net/w*/operstate ||
		grep -q -m1 '^up$' /sys/class/net/e*/operstate; } &&
		curl -sf --max-time 5 https://ifconfig.co/country --output "$countryfile" &&
		[ -s "$countryfile" ]
}

name=$(cat "$countryfile" 2>/dev/null) && rm -f "$countryfile" ||
	( flock -n 9 &&
		( tries=0; while [ $tries -ne 100 ]; do
			getcountry && break ||
				{ tries=$((tries+1)); sleep .1; }
		done
		[ -s "$countryfile" ] ||
			until getcountry; do sleep 60; done
		pkill -RTMIN+"${1:-27}" "${STATUSBAR:-dwmblocks}"
		) &
	echo; exit ) 9>"${XDG_RUNTIME_DIR}/sb-iplocate.lock"

[ -n "$name" ] || exit 0

flag="$(grep "flag: $name" "${XDG_DATA_HOME:-$HOME/.local/share}/larbs/chars/emoji")"
flag="${flag%% *}"
printf "%s %s\\n" "$flag" "$name"
