#!/bin/sh

# The daemon is started on demand by td-toggle, so it is normally not running.
# Without this guard transmission-remote prints a connection error to stderr on
# every bar refresh, which floods the session log.
pidof transmission-daemon >/dev/null 2>&1 || exit 0

transmission-remote -l 2>/dev/null | grep % |
	sed " # The letters are for sorting and will not appear.
	s/.*Stopped.*/A 🛑/;
	s/.*Seeding.*/Z 🌱/;
	s/.*100%.*/N ✅/;
	s/.*Idle.*/B 🕰️/;
	s/.*Uploading.*/L ⬆️/;
	s/.*%.*/M ⬇️/" |
		sort -h | uniq -c | awk '{print $3 $1}' | paste -sd ' ' -

case $BLOCK_BUTTON in
	1) setsid -f "$TERMINAL" -e watch -n 5 transmission-remote -l ;;
	2) td-toggle ;;
	3) notify-send "🌱 Torrent module" "\- Left click to show the transfer list.
- Middle click to toggle transmission.
- Shift click to edit script.
Module shows number of torrents:
🛑: paused
🕰: idle (seeds needed)
🔼: uploading (unfinished)
🔽: downloading
✅: done
🌱: done and seeding" ;;
	6) setsid -f "$TERMINAL" -e "$EDITOR" "$0" ;;
esac
