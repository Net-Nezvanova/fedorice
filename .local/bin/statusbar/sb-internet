#!/bin/sh

# Show wifi 📶 and percent strength or 📡 if none.
# Show 🌐 if connected to ethernet or ❎ if none.
# Show 🔒 if a vpn connection is active

case $BLOCK_BUTTON in
	1) "$TERMINAL" -e nmtui; pkill -RTMIN+4 dwmblocks ;;
	3) notify-send "🌐 Internet module" "\- Click to connect
❌: wifi disabled
📡: no wifi connection
📶: wifi connection with quality
❎: no ethernet
🌐: ethernet working
🔒: vpn is active
" ;;
	6) setsid -f "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

# Wifi
#
# Upstream reads the link quality out of /proc/net/wireless, which does not
# exist here: that file belongs to the old Wireless Extensions API, removed
# from the kernel in favour of nl80211. The awk found nothing, wifiicon stayed
# empty, and the block showed a bare ethernet ❎ -- reading as "offline" while
# the wifi was in fact connected.
#
# `iw` talks nl80211 directly, which makes it both the correct source and the
# cheap one: it reads from the driver in about 2ms, against ~22ms for the
# nmcli equivalent, and this block refreshes every 5 seconds. nmcli is kept
# only as a fallback for the case where iw is missing.
for wifidev in /sys/class/net/w*; do
	[ -e "$wifidev" ] || continue	# No wireless interface at all.
	case "$(cat "$wifidev/operstate" 2>/dev/null)" in
		up)
			# iw reports signal in dBm, not the 0-70 quality scale the old
			# /proc file used. Map it with the usual linear approximation,
			# where -100dBm is unusable and -50dBm or better is full strength.
			dbm="$(iw dev "${wifidev##*/}" link 2>/dev/null | awk '/^[[:space:]]*signal:/ {print $2; exit}')"
			if [ -n "$dbm" ]; then
				quality="$(( 2 * (dbm + 100) ))"
				[ "$quality" -gt 100 ] && quality=100
				[ "$quality" -lt 0 ] && quality=0
			else
				quality="$(nmcli -t -f IN-USE,SIGNAL device wifi 2>/dev/null | sed -n 's/^\*://p' | head -n 1)"
			fi
			# Connected but with no readable strength is still connected, so
			# show the icon alone rather than dropping the interface entirely.
			[ -n "$quality" ] && wifiicon="📶 $quality% " || wifiicon="📶 "
			;;
		down)
			[ "$(cat "$wifidev/flags" 2>/dev/null)" = '0x1003' ] && wifiicon="📡 " || wifiicon="❌ "
			;;
	esac
done

# Ethernet
[ "$(cat /sys/class/net/e*/operstate 2>/dev/null)" = 'up' ] && ethericon="🌐" || ethericon="❎"

# TUN
[ -n "$(cat /sys/class/net/tun*/operstate 2>/dev/null)" ] && tunicon=" 🔒"

printf "%s%s%s\n" "$wifiicon" "$ethericon" "$tunicon"
